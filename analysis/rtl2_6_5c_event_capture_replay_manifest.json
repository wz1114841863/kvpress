  "capture_rule": "Every observation names one immutable event, one declared schema owner, one declared schema carrier, exact schema-ordered integer fields, and accepted=true. accepted=false represents ready-low, stale, or otherwise unaccepted traffic and must emit no event.",
  "replay_cases": ["success_all_fourteen_event_types", "fault_fail_closed", "stale_response_rejected", "bounded_legal_ready_low"],
