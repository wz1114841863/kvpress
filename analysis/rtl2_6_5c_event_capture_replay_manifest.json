  "status": "testbench_accepted_carrier_capture_and_oracle_replay",
  "scope": "Versioned RTL2.6.5c testbench-only capture boundary. It admits an architectural event only from an explicitly accepted declared owner/carrier observation and replays the resulting event sequence through existing Python Route-A references. It is not a production-top observer, waveform/cycle trace, numeric datapath, HBM/controller model, performance claim, PPA claim, RTL-equivalence claim, model/GPU execution, or new A4 DSE.",
  "base_schema": "analysis/rtl2_scoreboard_event_schema.json",
  "capture_boundary": "rtl2_6_5c_testbench_accepted_carrier_observation",
  "captured_event_order": ["request_accept", "fragment_deliver", "write_commit", "descriptor_durable", "metadata_publish_commit", "authority_transition", "source_deliverable", "consumer_partial_commit", "source_release", "merge_request", "attention_terminal", "descriptor_invalidate", "page_free", "retire_ack"],
  "existing_bound_event_reuse": {
