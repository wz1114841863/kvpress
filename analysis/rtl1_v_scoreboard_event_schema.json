{
  "schema_version": "kvzap-route-a-rtl1-v-scoreboard-event-1.0",
  "status": "rtl1_v_subset_adapter_complete",
  "scope": "Testbench-only accepted transaction events for Python semantic scoreboarding; no cycle, timing, PPA, numeric datapath, controller, model, GPU, or RTL equivalence claim.",
  "canonical_domains": ["authority", "reclaim", "lifecycle"],
  "event_records": [
    {"domain": "authority", "event": "seed_hot", "required_fields": ["token"]},
    {"domain": "authority", "event": "mature", "required_fields": ["token", "keep"]},
    {"domain": "authority", "event": "open_packed_write", "required_fields": ["request_id", "token"]},
    {"domain": "authority", "event": "page_write_commit", "required_fields": ["request_id", "token"]},
    {"domain": "authority", "event": "begin_metadata_group", "required_fields": ["group_id", "members"]},
    {"domain": "authority", "event": "stage_metadata_member", "required_fields": ["group_id", "member"]},
    {"domain": "authority", "event": "metadata_atomic_publish", "required_fields": ["group_id"]},
    {"domain": "reclaim", "event": "allocate", "required_fields": ["ref", "layer", "kv_head"]},
    {"domain": "reclaim", "event": "payload_write_commit", "required_fields": ["ref"]},
    {"domain": "reclaim", "event": "descriptor_prepare", "required_fields": ["ref", "layer", "kv_head", "valid_count"]},
    {"domain": "reclaim", "event": "descriptor_terminal", "required_fields": ["operation_id", "success"]},
    {"domain": "reclaim", "event": "metadata_publish", "required_fields": ["ref"]},
    {"domain": "reclaim", "event": "retire", "required_fields": ["request_id", "incarnation"]},
    {"domain": "reclaim", "event": "quiesce", "required_fields": ["ref"]},
    {"domain": "reclaim", "event": "invalidate", "required_fields": ["ref"]},
    {"domain": "reclaim", "event": "invalidate_terminal", "required_fields": ["operation_id", "success"]},
    {"domain": "reclaim", "event": "finish_reclaim", "required_fields": ["ref"]},
    {"domain": "lifecycle", "event": "ack_init", "required_fields": ["acknowledgement"]},
    {"domain": "lifecycle", "event": "session_start", "required_fields": ["session_id", "context_tokens"]},
    {"domain": "lifecycle", "event": "kv_arrival", "required_fields": ["entry_id", "layer", "kv_head", "logical_position", "payload_ref"]},
    {"domain": "lifecycle", "event": "attention_accept", "required_fields": ["request_id", "incarnation", "layer", "kv_head", "query_position"]},
    {"domain": "lifecycle", "event": "gqa_complete", "required_fields": ["request_id", "incarnation"]},
    {"domain": "lifecycle", "event": "terminal", "required_fields": ["request_id", "incarnation", "success"]},
    {"domain": "lifecycle", "event": "retire", "required_fields": ["request_id", "incarnation", "session_id"]},
    {"domain": "lifecycle", "event": "drain_ack", "required_fields": ["acknowledgement"]},
    {"domain": "lifecycle", "event": "retire_ack", "required_fields": []}
  ],
  "forbidden": ["unaccepted speculative event", "implicit identity or generation default", "raw HBM byte observation", "Full-KV fallback event", "cycle or latency annotation", "arbitrary source-order reinterpretation"]
}
