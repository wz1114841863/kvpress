  },
  "canonical_order": {
    "source_kinds": ["hot", "pending", "packed"],
    "consumer_requirement": "four distinct consumer_id values for each present source before adapter advances",
    "not_a_claim": ["scheduler policy", "arbitrary reorder equivalence", "numeric merge order"]
  },
  "legal_packet": {
    "requires": [
      "nonempty R6-accepted SourceCompletionPlan copy",
      "matching owner availability identity and SourceInstance",
      "matching offer identity, SourceInstance, consumer ID and present bit",
      "header source and consumer match with merge-instance zero, reserved zero and count eight",
      "exact fragments zero through seven with last only at seven"
    ],
    "rejects_without_r4_commit": [
      "stale or unavailable identity",
      "source instance/generation mismatch",
      "absent source",
      "malformed header",
      "duplicate consumer",
      "malformed fragment ordering"
    ]
  },
  "directed_test": {
    "suite": "kvpress.routea.rtl2.RouteASourceServicePacketAdapterSpec",
    "cases": [
      "all seven nonempty source masks with four packets per present source",
      "stale availability, malformed header and duplicate consumer fail closed",
      "R4 consumer-commit backpressure holds the next coupled packet before fragment acceptance"
    ],
    "command": "cd hardware/route_a/chisel && env JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64 sbt -batch 'testOnly kvpress.routea.rtl2.RouteASourceServicePacketAdapterSpec'"
