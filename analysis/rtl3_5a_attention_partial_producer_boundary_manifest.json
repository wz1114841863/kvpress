    "query_rope_state": "already_applied_by_common_frontend",
    "key_rope_state": "already_applied_at_kv_creation",
    "provider_rule": "provider does not apply or re-apply RoPE to Q or K",
    "position_rule": "source positions are exact ordered semantic inputs for causal visibility and association; they do not choose a position-cache or sidecar transport"
  },
  "output_rule": {
    "existing_carriers": ["SourceServicePartialOffer", "SourceServiceValueFragment"],
    "present_source": "one present header and eight ordered 64-byte fragments per accepted source work item and consumer",
    "excluded_source": "no provider work or data-bearing packet; existing functional R4 provider inserts only the frozen absent identity from accepted source_presence",
    "ownership": "provider cannot commit a consumer, release a source, change authority, emit an R4 result, or emit an outward terminal"
  },
  "fail_closed": {
    "rejected_before_acceptance": ["missing_or_mismatched_query_association", "invalid_query_head_mapping", "query_or_source_identity_mismatch", "source_generation_mismatch", "position_count_or_order_mismatch", "RoPE_or_attention_profile_mismatch", "causal_visibility_violation"],
    "effects": ["no_partial_packet", "no_consumer_commit", "no_source_release", "no_authority_transition", "no_Full_KV_substitution", "no_mask_or_admission_change"],
    "classification": "environment-interface violation, not an R4 numeric_fault"
  },
  "forbidden": [
