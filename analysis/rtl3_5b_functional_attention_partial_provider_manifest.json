{
  "schema_version": "kvzap-route-a-rtl3-5b-functional-attention-partial-provider-1.0",
  "status": "implemented_pure_software_functional_partial_provider_pre_numeric_rtl",
  "scope": "Pure-software functional reference model for the already frozen RTL3.5-A query/source association. No Chisel partial producer, production top activation, numerical RTL, cycle/timing/throughput, PPA, model/GPU, or A4 DSE claim.",
  "partial_owner": "route_a_functional_attention_partial_provider",
  "input_profiles": {
    "rope": "qwen3_rope_applied_at_q_and_k_creation_v1",
    "attention": "qwen3_gqa_scaled_causal_attention_v1"
  },
  "qwen_anchor": {
    "layer_count": 36,
    "kv_head_count": 8,
    "query_head_count": 32,
    "query_heads_per_kv_head_group": 4,
    "query_head_mapping": "query_head = 4 * kv_head + consumer_id",
    "head_dim": 128,
    "semantic_attention_scale": "1 / sqrt(128)"
  },
  "accepted_inputs": {
    "query": ["transaction_identity", "layer", "kv_head", "consumer_id", "query_head", "query_position", "already_RoPE_applied_128_lane_query"],
    "source_lease": ["transaction_identity", "layer", "kv_head", "source_kind", "source_instance_coordinate", "source_generation", "increasing_logical_positions", "already_RoPE_applied_128_lane_K", "128_lane_V"],
    "acceptance": "exact association plus causal source positions at or before query_position"
  },
  "existing_output_carriers": ["SourceServicePartialOffer", "SourceServiceValueFragment"],
  "output": {
    "partial": "one present binary32 (m,l,o[128]) packet per accepted source lease and consumer",
    "packet": "one existing header plus eight ordered 64-byte fragments",
    "reference_bridge": "as_r4_accepted_packet is test-only conversion for RTL3.4-B provider and cannot bypass Chisel structural acceptance"
  },
  "failure": {
    "class": "rejected_before_acceptance_environment_interface_violation",
    "cases": ["identity_layer_or_kv_head_mismatch", "invalid_GQA_mapping", "source_generation_or_profile_mismatch", "empty_or_unordered_position_sequence", "causal_visibility_violation", "nonfinite_Q_K_or_V", "unencodable_partial"],
    "effects": ["no_partial_offer", "no_fragment", "no_consumer_commit", "no_source_release", "no_authority_transition", "no_Full_KV_fallback"]
  },
  "forbidden": [
    "Chisel_attention_MAC_or_RoPE_RTL",
    "production_top_activation",
    "source_owner_partial_computation",
    "scheduler_or_authority_change",
    "timing_throughput_or_PPA_claim",
    "new_A4_DSE"
  ],
  "verification": {
    "pytest_command": ".venv/bin/python -m pytest -q tests/test_route_a_merge_numeric_reference.py tests/test_rtl3_4b_functional_r4_provider.py tests/test_rtl3_5b_functional_attention_partial_provider.py tests/test_rtl3_5b_functional_attention_partial_provider_manifest.py",
    "validator_command": ".venv/bin/python tools/validate_rtl3_5b_functional_attention_partial_provider.py",
    "evidence_labels": ["pure-software functional PE/reference model", "no model/GPU", "no cycle/timing/throughput claim", "no PPA claim", "no RTL numeric correctness claim", "no new A4 DSE"]
  },
