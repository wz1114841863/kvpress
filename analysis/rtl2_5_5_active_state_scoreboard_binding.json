  ],
  "chisel_adapter":{"module":"testbench_route_a_reclaim_scoreboard_adapter","source":"hardware/route_a/chisel/src/test/scala/kvpress/routea/rtl2/RouteAReclaimScoreboardAdapterSpec.scala","rule":"Each observed carrier and all of its matching event fanout handshakes atomically; ready-low delays all of them and cannot produce a partial/replay event."},
