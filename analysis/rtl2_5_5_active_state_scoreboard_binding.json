  "forbidden":["rewrite historical rtl2_scoreboard_event_schema.json","infer event from arbitrary internal state","production-top scoreboard adapter instantiation","allocator free command from event","physical HBM or descriptor-macro claim","cycle latency throughput PPA model GPU numeric or A4 DSE claim"],
