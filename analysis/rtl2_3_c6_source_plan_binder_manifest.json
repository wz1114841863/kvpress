  ],
  "binding": {
    "upstream_declaration_owner": "environment-owned already-selected source declaration",
    "rtl_plan_producer": "route_a_source_plan_binder",
    "r6_plan_consumer": "route_a_lifecycle_adapter",
    "top_role": "composition-only declaration ingress and binder wiring",
    "not_owned_by_binder": [
      "source presence selection",
      "source scheduler",
      "attention tracker allocation",
      "source availability or residency",
      "source packet/partial generation",
      "R4 merge or terminal"
    ]
  },
  "acceptance": {
    "requires": [
      "nonempty source_presence",
      "hot/pending/packed canonical kind tuple 0/1/2",
      "single binder holding slot empty"
    ],
    "exactly_copied_fields": [
      "transaction_identity",
      "source_presence",
      "hot_instance",
      "pending_instance",
      "packed_instance"
    ],
    "fail_closed": [
      "empty source_presence",
      "noncanonical source-kind tuple",
      "second declaration while held output awaits R6"
    ],
    "ready_low_rule": "all held completion-plan fields remain unchanged while R6 ready is low"
  },
  "directed_tests": {
    "suite": "kvpress.routea.rtl2.RouteASourcePlanBinderSpec",
    "coverage": [
      "all seven nonempty source masks",
      "empty and noncanonical declarations rejected",
      "exact plan hold under R6 backpressure"
    ],
    "regressions": [
      "kvpress.routea.structural.RouteAKVSubsystemTopSpec",
      "kvpress.routea.integration.RouteAInitDrainIntegrationSpec"
    ]
  },
