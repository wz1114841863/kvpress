{
  "schema_version": "kvzap-route-a-rtl2-3-c6-source-plan-binder-1.0",
  "status": "implemented_directed_tested_source_declaration_to_r6_plan_only",
  "scope": "Finite structural binding from an upstream immutable source declaration to R6's SourceCompletionPlan. No source-set selection, scheduler, source residency, payload, packet, R4, numeric, controller, timing, throughput, PPA, model/GPU, or new A4 DSE behavior.",
  "references": [
    "analysis/rtl2_3_reconciliation_01.md",
